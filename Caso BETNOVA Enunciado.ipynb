   "source": [
    "#Condición sea jugador valioso\n",
    "dias_activo_90 = df[\"dias_activos_90d\"] > df[\"dias_activos_90d\"].quantile(0.65)\n",
    "depositos_90 = df[\"depositos_90d\"] > df[\"depositos_90d\"].quantile(0.65)\n",
    "imp_depositado_90 = df[\"importe_depositado_90d\"] > df[\"importe_depositado_90d\"].quantile(0.65)\n",
    "\n",
    "\n",
    "resultado= (\n",
    "    dias_activo_90 \n",
    "    & depositos_90 \n",
    "    & imp_depositado_90\n",
    ")\n",
    "\n",
    "\n",
    "df[\"jugador_valioso\"] = np.where(resultado, 1, 0)\n",
    "y = df[\"jugador_valioso\"]"
