   "source": [
    "# DECILES\n",
    "variables_deciles = [\n",
    "    \"importe_apostado_60d\",\n",
    "    \"sesiones_60d\",\n",
    "    \"dias_activos_60d\",\n",
    "    \"importe_depositado_60d\"\n",
    "]\n",
    "\n",
    "for var in variables_deciles:\n",
    "    deciles = pd.qcut(df[var], q=10, duplicates=\"drop\")\n",
    "    tabla = df.groupby(deciles, observed=True)[\"jugador_valioso\"].agg(\n",
    "        n_jugadores=\"count\",\n",
    "        n_valiosos=\"sum\",\n",
    "        tasa_valiosos=\"mean\"\n",
    "    )\n",
    "    tabla[\"tasa_valiosos\"] = (tabla[\"tasa_valiosos\"] * 100).round(1)\n",
    "    print(f\"\\n=== {var} ===\")\n",
    "    display(tabla)"
   ]
